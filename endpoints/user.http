@baseURL = http://localhost:5000
@urlPath = api/v1


### GET USER
GET {{baseURL}}/{{urlPath}}/users/userId
Content-Type: application/json
Accept: application/json

### GET USER LIST WITH TYPE ( type= 'friends' | 'follower' | 'requests' | ' following'}
GET {{baseURL}}/{{urlPath}}/users-list/:page/:type
Content-Type: application/json
Accept: application/json


### GET IMAGES FROM USER
GET {{baseURL}}/{{urlPath}}/users/nguyenhuydu1/images
Content-Type: application/json
Accept: application/json

{
    "sort":"descc123123",
    "max":10
}

### UPDATE AVARTAR
PUT {{baseURL}}/{{urlPath}}/update-avatar
Content-Type: application/json
Accept: application/json

{
    "text":"Update avatar",
    "avatar":"data:image/jpeg;base64,"
}

### UPDATE COVER
PUT {{baseURL}}/{{urlPath}}/update-cover
Content-Type: application/json
Accept: application/json

{
    "text":"Update cover",
    "avatar":"12312"
}


### UPDATE INFO
PUT {{baseURL}}/{{urlPath}}/update-info
Content-Type: application/json
Accept: application/json

{
  "detailsInfo": {
    "bio": "My name is Du4",
    "otherName": "DuDev1",
    "job": "Stud3ent",
    "workplace": "ABC",
    "highSchool": "BCA",
    "college": "ACC",
    "currentCity": "ACB",
    "homeTown": "CAB",
    "relationship": "Single"
  }
}


### ADD FRIEND
PUT {{baseURL}}/{{urlPath}}/add-friend/67cc505cd8a6a9d3c8086f99
Content-Type: application/json
Accept: application/json


### CANCLE REQUEST
PUT {{baseURL}}/{{urlPath}}/cancle-request/6704cb04410cc9b0c6597f03
Content-Type: application/json
Accept: application/json


### FOLLOW
PUT {{baseURL}}/{{urlPath}}/follow/6704cb04410cc9b0c6597f03
Content-Type: application/json
Accept: application/json


### UNFOLLOW
PUT {{baseURL}}/{{urlPath}}/unfollow/6704cb04410cc9b0c6597f03
Content-Type: application/json
Accept: application/json



### ACCEPT REQUEST
PUT {{baseURL}}/{{urlPath}}/accept-request/6704cc0abf34f3d05fd85d66
Content-Type: application/json
Accept: application/json



### UNFRIEND
PUT {{baseURL}}/{{urlPath}}/unfriend/6704cc0abf34f3d05fd85d66
Content-Type: application/json
Accept: application/json


### DELETE REQUEST
PUT {{baseURL}}/{{urlPath}}/delete-request/6704cc0abf34f3d05fd85d66
Content-Type: application/json
Accept: application/json


### SEARCH USERS
GET {{baseURL}}/{{urlPath}}/search/
Content-Type: application/json
Accept: application/json


### ADD TO SEARCH HISTORY
POST {{baseURL}}/{{urlPath}}/add-to-search-history
Content-Type: application/json
Accept: application/json

{
  "searchUser":"6704cc0abf34f3d05fd85d66"
}


### GET LIST SEARCHED
GET {{baseURL}}/{{urlPath}}/list-searched
Content-Type: application/json
Accept: application/json










